  // Tier 1: synchronous Tesseract pre-fill output (raw OCR text + per-field extracted values)
  ocrData                 Json?
  // Tier 2: async Qwen3.6 VLM extraction result (structured JSON with confidence scores)
  vlmExtractionResult     Json?
  // Tier 2: VLM gatekeeper assessment (plate authenticity, anomaly flags, recommended action)
  vlmGatekeeperResult     Json?
  // BullMQ job ID for the async VLM processing job
  vlmJobId                String?

enum PositionType {
  FIXED
  ADJUSTABLE
  MODULAR
  SLIDING
}

enum FitmentConfidence {
  VERIFIED
  MANUFACTURER_SPEC
  COMMUNITY
  ESTIMATED
}

enum FitmentSource {
  OEM
  AFTERMARKET_VERIFIED
  USER_SUBMITTED
  CALCULATED
}

model AccessoryFitment {
  id                        String             @id @default(cuid())
  accessoryId               String
  vehicleVariantId          String?
  caravanVariantId          String?
  installedWeightKg         Decimal            @db.Decimal(8, 2)
  positionType              PositionType
  cogXMm                    Int?
  cogYMm                    Int?
  startXMm                  Int?
  endXMm                    Int?
  mountingLocation          MountingLocation
  providesMountingLocations MountingLocation[]
  mountOffsetXMm            Int?
  mountOffsetYMm            Int?
  mountOffsetZMm            Int?
  tankCapacityL             Decimal?           @db.Decimal(8, 2)
  tankContentsKgPerL        Decimal?           @db.Decimal(6, 3)
  confidence                FitmentConfidence  @default(ESTIMATED)
  source                    FitmentSource      @default(USER_SUBMITTED)
  notes                     String?
  verifiedById              String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  accessory                 Accessory          @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  vehicleVariant            VehicleVariant?    @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)
  caravanVariant            CaravanVariant?    @relation(fields: [caravanVariantId], references: [id], onDelete: Cascade)
  verifiedBy                User?              @relation("FitmentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  setupAccessories        SetupAccessory[]
  setupCaravanAccessories SetupCaravanAccessory[]
  accessorySubmissions    AccessorySubmission[]
  positionSubmissions     FitmentPositionSubmission[]

  @@index([vehicleVariantId, mountingLocation])
  @@index([caravanVariantId, mountingLocation])
  @@index([accessoryId])
}

// Community position pipeline: a user who has dragged an accessory into place
// on their rig (the top-down view) can contribute that placement. Submissions
// are PENDING until a moderator promotes the value onto the canonical
// AccessoryFitment.cogXMm/cogYMm, after which every future calculator that adds
// the accessory inherits the community-sourced default. This is the data moat.
model FitmentPositionSubmission {
  id               String           @id @default(cuid())
  submitterId      String?
  fitmentId        String
  vehicleVariantId String?
  caravanVariantId String?
  cogXMm           Int
  cogYMm           Int
  status           SubmissionStatus @default(PENDING)
  source           String?
  decidedById      String?
  decidedAt        DateTime?
  decisionNotes    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  submitter        User?            @relation("PositionSubmissions", fields: [submitterId], references: [id], onDelete: SetNull)
  decidedBy        User?            @relation("PositionSubmissionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  fitment          AccessoryFitment @relation(fields: [fitmentId], references: [id], onDelete: Cascade)
  vehicleVariant   VehicleVariant?  @relation(fields: [vehicleVariantId], references: [id], onDelete: SetNull)
  caravanVariant   CaravanVariant?  @relation(fields: [caravanVariantId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([fitmentId, status])
  @@index([vehicleVariantId])
  @@index([submitterId])
}

enum RegulationSetCode {
  AU_ADR
  NZ_VIRM
  US_FMVSS
  EU_UNECE
  GB_IVA
}

model Setup {
  id                      String                   @id @default(cuid())
  userId                  String
  name                    String
  vehicleVariantId        String?
  caravanVariantId        String?
  passengers              Int                      @default(2)
  cargoKg                 Decimal                  @default(0) @db.Decimal(8, 2)
  fuelPercent             Int                      @default(100)
  freshWaterPercent       Int                      @default(100)
  greyWaterPercent        Int                      @default(0)
  calibrationOverrides    Json                     @default("{}")
  // GVM-upgrade overlay the user applied to their vehicle. Either a catalogue
  // GvmUpgrade kit (appliedGvmUpgradeId) or a free-form custom entry for an
  // engineer-cert / plate path (customGvmUpgrade JSON: { gvmKg, gcmKg?, axle?,
  // maxTowingKg?, addedMassKg, ... }). The physics overlay (P5) is gated/advisory.
  appliedGvmUpgradeId     String?
  customGvmUpgrade        Json?
  vehicleSnapshot         Json?
  caravanSnapshot         Json?
  accessorySnapshot       Json?
  tags                    String[]
  shareToken              String                   @unique @default(cuid())
  regulationSetCode       RegulationSetCode        @default(AU_ADR)
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleVariant          VehicleVariant?          @relation(fields: [vehicleVariantId], references: [id], onDelete: SetNull)
  caravanVariant          CaravanVariant?          @relation(fields: [caravanVariantId], references: [id], onDelete: SetNull)
  appliedGvmUpgrade       GvmUpgrade?              @relation(fields: [appliedGvmUpgradeId], references: [id], onDelete: SetNull)
  accessories             SetupAccessory[]
  caravanAccessories      SetupCaravanAccessory[]
  customLoads             SetupCustomLoad[]
  weighbridgeMeasurements WeighbridgeMeasurement[]
  versions                SetupVersion[]

  @@index([userId])
  @@index([vehicleVariantId])
  @@index([caravanVariantId])
  @@index([appliedGvmUpgradeId])
  @@index([shareToken])
  @@index([deletedAt])
}


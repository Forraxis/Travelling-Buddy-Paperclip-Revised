/**
 * AI/admin-assisted vehicle-spec ingestion (vehicle-data-fetch). A *candidate*
 * holding-pen — the spec equivalent of VehicleSubmission. It is NOT a
 * VehicleVariant and never materialises one until an admin promotes it, so a
 * candidate can never leak into public search/calculator (those query
 * VehicleVariant). Promotion creates/updates a CATALOGUE VehicleVariant via the
 * same transaction shape as the moderation approve path (ModerationAction +
 * AuditLog). `rawResponse` keeps the verbatim provider output (store raw, derive
 * later — mirrors the calibration moat). See OVERNIGHT_HANDOVER.md / RIG_LAYOUT.
 */
model VehicleSpecCandidate {
  id          String           @id @default(cuid())
  // Targeting — what the admin searched for. Free text; resolved to make/model
  // (creating them if needed) only at promotion time.
  makeName    String
  modelName   String
  variantName String?
  yearFrom    Int
  yearTo      Int?
  bodyType    VehicleBodyType?
  market      Market           @default(AU)

  // Provenance of the whole fetch.
  provider        SpecFetchProvider
  providerModel   String?
  promptVersion   String?
  // ROVER provenance — the federal RVSA approval this candidate was parsed from.
  // Null for the LLM/admin paths. sourceVtaNumber is the dedupe key for the
  // incremental crawl (a re-run upserts the same VTA, never duplicates it).
  sourceVtaNumber String?
  sourceReportUrl String?
  // Verbatim provider output (store raw, derive later), JSON. Null on a failed fetch.
  rawResponse     Json?
  fetchError      String?

  // Lifecycle. PENDING once fetched, APPROVED on promote, REJECTED on discard.
  status     SubmissionStatus @default(PENDING)
  // BullMQ job id for the async (qwen) fetch path; null for synchronous (mock) fetches.
  fetchJobId String?

  // Gating override (Phase 4): an admin explicitly allowed promotion of one or
  // more uncorroborated compliance-critical fields. Records who/when/why.
  criticalOverrideById String?
  criticalOverrideAt   DateTime?
  criticalOverrideNote String?

  // Promotion linkage + decision audit.
  resultingVariantId String?
  createdById        String?
  decidedById        String?
  decidedAt          DateTime?
  decisionNotes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields             VehicleSpecCandidateField[]
  resultingVariant   VehicleVariant?             @relation("SpecCandidateVariant", fields: [resultingVariantId], references: [id], onDelete: SetNull)
  createdBy          User?                       @relation("SpecCandidatesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy          User?                       @relation("SpecCandidateDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  criticalOverrideBy User?                       @relation("SpecCandidateOverrides", fields: [criticalOverrideById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([resultingVariantId])
  @@index([makeName, modelName])
  @@index([createdById])
  @@index([sourceVtaNumber])
}

/**
 * One fetched field of a VehicleSpecCandidate, with its own provenance. The
 * per-field sidecar: a provider returns value + confidence + source per field,
 * and compliance-critical fields are gated independently of soft fields.
 * `value`/`adminValue` are canonical string form (null = "couldn't find it",
 * never 0); the promotion mapper parses them into the typed VehicleVariant column.
 */
model VehicleSpecCandidateField {
  id                   String               @id @default(cuid())
  candidateId          String
  // Canonical VehicleVariant column name, e.g. "gvmKg", "wheelbaseMm".
  field                String
  // Provider-suggested value (canonical string form). Null = not found, NOT zero.
  value                String?
  confidence           SpecFieldConfidence?
  sourceUrl            String?
  provider             SpecFetchProvider
  // Whether this field gates promotion to CATALOGUE (GVM/GCM/axle/tow-ball/towing).
  isComplianceCritical Boolean              @default(false)
  // Admin's reviewed value — overrides `value` at promotion when set.
  adminValue           String?
  // Admin explicitly corroborated this field (authoritative source / plate).
  // The ONLY trust signal that satisfies the critical-field gate (never confidence).
  corroborated         Boolean              @default(false)
  notes                String?
  candidate            VehicleSpecCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, field])
  @@index([candidateId])
}

/**
 * ROVER source-of-truth archive. One row per parsed per-VTA document (RVD or
 * Approval Notice). Stores the FULL extracted text + full structured parse — not
 * just the fields the calculator uses — so the data is re-mineable for future
 * TravellingBuddy projects (the "store raw, derive later" decision in
 * VEHICLE_DATA_FETCH.md). `VehicleVariant` stays a curated projection of this.
 * Idempotent + versioned by `contentHash`: re-importing identical content is a
 * no-op; an amended approval (different hash) is a NEW row, so history is kept and
 * versions for one VTA are distinguishable.
 */
model RoverDocument {
  id          String       @id @default(cuid())
  vtaNumber   String
  docType     RoverDocType
  // sha256 of the raw extracted text — identity + change-detection key.
  contentHash String

  fileName           String?
  make               String?
  model              String?
  // Broad category from the RVD ("N - Goods Vehicles"); fine category from the
  // Approval Notice ("NA - Light Goods Vehicle").
  categoryBroad      String?
  categoryFine       String?
  // Dates as ISO strings (yyyy-mm-dd). generatedDate = RVD download date; the
  // approval/variation/expiry come from the Approval Notice.
  generatedDate      String?
  validFrom          String?
  variationValidFrom String?
  expiresOn          String?

  // Verbatim extracted text + the full structured parse (RvdDocument / ApprovalNotice).
  rawText      String
  parsed       Json
  variantCount Int    @default(0)

  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([vtaNumber, docType, contentHash])
  @@index([vtaNumber])
  @@index([docType])
}

// ROVER skeleton index — the enumerable "names" layer of catalogue population
// (VEHICLE_DATA_HUB.md §6.5, Layer 0). One row per VTA from the grid crawl: make /
// model / category, browsable immediately. "Expand" (the RVD detail fetch) turns an
// UNFETCHED skeleton into real VehicleVariants. Cheap to populate (grid only, no PDF).
model RoverApprovalIndex {
  id                  String                   @id @default(cuid())
  vtaNumber           String                   @unique
  // The rvr_approvalid GUID — the key for the VTADetails fetch that expands this.
  approvalId          String
  // Applicant free text as ROVER states it — for second-stage approvals the modifier
  // is baked into the make ("PREMCAR", "IRONMAN TOYOTA", "CAR NISSAN").
  make                String?
  model               String?
  // ADR category CODE as the grid states it (MA, NB1, NC, …).
  category            String?
  // Grid rvr_publishedlastupdatedate.
  lastUpdated         DateTime?
  // ── Normalized identity (the normalization pass; VEHICLE_DATA_HUB.md §3.5) ──
  // Resolved OEM make/model the hub groups by ("Nissan" / "D23 Navara"); the modifier
  // (e.g. "Premcar") is captured separately and becomes a second-stage overlay.
  baseMake            String?
  baseModel           String?
  modifier            String?
  isSecondStage       Boolean                  @default(false)
  // What kind of second-stage manufacture this is, once classified (P2). NONE for
  // base/OEM variants. Drives GVM-upgrade-vs-standalone promotion routing (P4).
  secondStageType     RoverSecondStageType     @default(NONE)
  normalizationStatus RoverNormalizationStatus @default(UNPROCESSED)
  expandState         RoverIndexExpandState    @default(UNFETCHED)
  // Set once expanded → the resulting catalogue model.
  resultingModelId    String?
  // Flattened grid attributes — kept raw for later mining (raw-archive-now).
  raw                 Json?
  firstSeenAt         DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([make])
  @@index([baseMake, baseModel])
  @@index([category])
  @@index([expandState])
  @@index([normalizationStatus])
  @@index([secondStageType])
}

/**
 * Normalization state of a QldFleetVehicle row (set by qld-normalize-local.ts).
 * AUTO = make+model canonicalised confidently (known model or ROVER-corroborated).
 * NEEDS_REVIEW = canonical make but ambiguous model → the multi-agent AI residue.
 * JUNK = non-canonical make (the rare import/typo tail, <1% of registrations).
 */
enum QldNormStatus {
  AUTO
  NEEDS_REVIEW
  JUNK
}

/**
 * QLD "Vehicle registrations — Light Vehicles" fleet seed (data.qld.gov.au open data).
 * Identity + plated GVM/kerb + on-road prevalence + a real-world GVM-upgrade signal,
 * aggregated per (make, model, year, body) by `src/jobs/qld-fleet-ingest-local.ts`.
 * STAGING ONLY — not the live catalogue and NOT verified (plate stays the only green).
 * No badge / GCM / axle here (those come from ROVER / AI / manual — see VEHICLE_DATA_SOURCES.md).
 */
model QldFleetVehicle {
  id                String        @id @default(cuid())
  // normalized identity (the grouping key)
  make              String
  model             String
  yearOfManufacture Int
  bodyShape         String
  // attributes
  fuelType          String?
  cylinders         Int?
  // derived plated specs (mode across registrations = factory figure)
  factoryGvmKg      Int?
  kerbTareKg        Int?
  // prevalence + GVM-upgrade-in-the-wild signal
  registrationCount Int           @default(0)
  gvmDistinctCount  Int           @default(0)
  gvmMinKg          Int?
  gvmMaxKg          Int?
  gvmUpgradeSignal  Boolean       @default(false)
  gvmDistribution   Json?
  // normalization (qld-normalize-local.ts) — canonical names + AUTO/NEEDS_REVIEW/JUNK split
  canonicalMake     String?
  canonicalModel    String?
  normStatus        QldNormStatus @default(NEEDS_REVIEW)
  roverMatched      Boolean       @default(false)
  // provenance
  source            String        @default("QLD_LIGHT_VEHICLE_FLEET")
  ingestedAt        DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([make, model, yearOfManufacture, bodyShape])
  @@index([make, model])
  @@index([registrationCount])
  @@index([gvmUpgradeSignal])
  @@index([normStatus])
  @@index([canonicalMake, canonicalModel])
}

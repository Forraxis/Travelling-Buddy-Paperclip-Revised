generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VehicleVariantStatus {
  CATALOGUE
  COMMUNITY
}

enum VehicleBodyType {
  DUAL_CAB_UTE
  SINGLE_CAB_UTE
  EXTRA_CAB_UTE
  WAGON
  SUV
  VAN
  TROOPCARRIER
  OTHER
}

enum FuelType {
  DIESEL
  PETROL
  HYBRID
  ELECTRIC
}

enum Market {
  AU
  NZ
  US
  EU
  GB
}

enum CaravanBodyType {
  CARAVAN_POP_TOP
  CARAVAN_FULL_HEIGHT
  OFF_ROAD_CARAVAN
  CAMPER_TRAILER
  HYBRID
  FIFTH_WHEELER
  OTHER
}

enum AxleConfiguration {
  SINGLE_AXLE
  DUAL_AXLE_CLOSE_COUPLED
  DUAL_AXLE_SPREAD
  TRIPLE_AXLE
}

enum CaravanVariantStatus {
  CATALOGUE
  COMMUNITY
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum PlacementScope {
  VEHICLE
  CARAVAN
  BOTH
}

enum AccessoryStatus {
  ACTIVE
  DISCONTINUED
  PLACEHOLDER
  COMMUNITY
}

model VehicleMake {
  id              String         @id @default(cuid())
  name            String         @unique
  slug            String         @unique
  logoUrl         String?
  countryOfOrigin String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  models          VehicleModel[]

  @@index([slug])
}

model VehicleModel {
  id        String           @id @default(cuid())
  makeId    String
  name      String
  slug      String
  bodyType  VehicleBodyType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  make      VehicleMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants  VehicleVariant[]

  @@unique([makeId, slug])
  @@index([slug])
  @@index([makeId])
}

model VehicleVariant {
  id                       String                        @id @default(cuid())
  modelId                  String
  yearFrom                 Int
  yearTo                   Int
  isCurrentProduction      Boolean                       @default(false)
  name                     String
  slug                     String
  // Community-submitted variants have status=COMMUNITY until moderation approves them.
  // Catalogue entries are CATALOGUE (default).
  status                   VehicleVariantStatus          @default(CATALOGUE)
  communitySubmitterId     String?
  gvmKg                    Int?
  gcmKg                    Int?
  kerbWeightKg             Int?
  maxTowingCapacityKg      Int?
  frontAxleLimitKg         Int?
  rearAxleLimitKg          Int?
  wheelbaseMm              Int?
  frontOverhangMm          Int?
  rearOverhangMm           Int?
  totalLengthMm            Int?
  maxTowBallDownloadKg     Int?
  fuelTankCapacityL        Int?
  fuelType                 FuelType?
  market                   Market                        @default(AU)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  model                    VehicleModel                  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  communitySubmitter       User?                         @relation("CommunityVehicleVariants", fields: [communitySubmitterId], references: [id], onDelete: SetNull)
  fitments                 AccessoryFitment[]
  setups                   Setup[]
  vehicleSubmissions       VehicleSubmission[]
  accessorySubmissions     AccessorySubmission[]
  positionSubmissions      FitmentPositionSubmission[]
  calibrationContributions CalibrationContribution[]
  calibrationCorrection    VehicleCalibrationCorrection?

  @@unique([modelId, slug])
  @@index([slug])
  @@index([modelId])
  @@index([status, communitySubmitterId])
}

model CaravanMake {
  id              String         @id @default(cuid())
  name            String         @unique
  slug            String         @unique
  logoUrl         String?
  countryOfOrigin String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  models          CaravanModel[]

  @@index([slug])
}

model CaravanModel {
  id        String           @id @default(cuid())
  makeId    String
  name      String
  slug      String
  bodyType  CaravanBodyType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  make      CaravanMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants  CaravanVariant[]

  @@unique([makeId, slug])
  @@index([slug])
  @@index([makeId])
}

model CaravanVariant {
  id                   String                      @id @default(cuid())
  modelId              String
  status               CaravanVariantStatus        @default(CATALOGUE)
  communitySubmitterId String?
  yearFrom             Int
  yearTo               Int
  isCurrentProduction  Boolean                     @default(false)
  name                 String
  slug                 String
  atmKg                Int?
  gtmKg                Int?
  tareKg               Int?
  tbmKg                Int?
  axleConfiguration    AxleConfiguration
  couplingToAxleMm     Int?
  axleSpacingMm        Int?
  bodyLengthMm         Int?
  overallLengthMm      Int?
  freshWaterCapacityL  Int?
  greyWaterCapacityL   Int?
  gasBottleConfig      String?
  market               Market                      @default(AU)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  model                CaravanModel                @relation(fields: [modelId], references: [id], onDelete: Cascade)
  communitySubmitter   User?                       @relation("CommunityCaravanVariants", fields: [communitySubmitterId], references: [id], onDelete: SetNull)
  fitments             AccessoryFitment[]
  setups               Setup[]
  caravanSubmissions   CaravanSubmission[]
  accessorySubmissions AccessorySubmission[]
  positionSubmissions  FitmentPositionSubmission[]

  @@unique([modelId, slug])
  @@index([slug])
  @@index([modelId])
  @@index([status, communitySubmitterId])
}

model AccessoryBrand {
  id                   String                @id @default(cuid())
  name                 String                @unique
  slug                 String                @unique
  logoUrl              String?
  websiteUrl           String?
  status               BrandStatus           @default(ACTIVE)
  isPartner            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accessories          Accessory[]
  accessorySubmissions AccessorySubmission[]

  @@index([slug])
}

model AccessoryCategory {
  id                   String                @id @default(cuid())
  name                 String                @unique
  slug                 String                @unique
  description          String?
  parentId             String?
  displayOrder         Int                   @default(0)
  iconName             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  parent               AccessoryCategory?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children             AccessoryCategory[]   @relation("CategoryHierarchy")
  accessories          Accessory[]
  accessorySubmissions AccessorySubmission[]
  sponsoredPlacements  SponsoredPlacement[]

  @@index([slug])
  @@index([parentId])
}

model Accessory {
  id                   String                @id @default(cuid())
  brandId              String
  categoryId           String
  name                 String
  slug                 String
  description          String?
  imageUrls            String[]
  priceMin             Decimal?              @db.Decimal(10, 2)
  priceMax             Decimal?              @db.Decimal(10, 2)
  currencyCode         String                @default("AUD")
  affiliateUrl         String?
  status               AccessoryStatus       @default(ACTIVE)
  market               Market                @default(AU)
  /**
   * Where this item may be mounted in the layout editor.
   */
  placementScope       PlacementScope        @default(BOTH)
  /**
   * Optional real top-down image (R2) — overrides the category icon.
   */
  topDownImageUrl      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  brand                AccessoryBrand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category             AccessoryCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fitments             AccessoryFitment[]
  accessorySubmissions AccessorySubmission[]
  sponsoredPlacements  SponsoredPlacement[]

  @@unique([brandId, slug])
  @@index([slug])
  @@index([brandId])
  @@index([categoryId])
}

enum UserRole {
  ADMIN
  MODERATOR
  CONTRIBUTOR
  VIEWER
}

enum AustralianState {
  NSW
  VIC
  QLD
  WA
  SA
  TAS
  NT
  ACT
}

enum TrustTier {
  NEW
  BASIC
  TRUSTED
  EXPERT
}

model User {
  id                               String                      @id @default(cuid())
  name                             String?
  email                            String                      @unique
  emailVerified                    DateTime?
  image                            String?
  password                         String?
  role                             UserRole                    @default(VIEWER)
  homeState                        AustralianState?
  trustTier                        TrustTier                   @default(NEW)
  notificationPreferences          Json                        @default("{}")
  deletedAt                        DateTime?
  scheduledHardDeleteAt            DateTime?
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime                    @updatedAt
  accounts                         Account[]
  sessions                         Session[]
  setups                           Setup[]
  verifiedFitments                 AccessoryFitment[]          @relation("FitmentVerifier")
  vehicleSubmissions               VehicleSubmission[]         @relation("VehicleSubmissions")
  vehicleSubmissionDecisions       VehicleSubmission[]         @relation("VehicleSubmissionDecisions")
  caravanSubmissions               CaravanSubmission[]         @relation("CaravanSubmissions")
  caravanSubmissionDecisions       CaravanSubmission[]         @relation("CaravanSubmissionDecisions")
  accessorySubmissions             AccessorySubmission[]       @relation("AccessorySubmissions")
  accessorySubmissionDecisions     AccessorySubmission[]       @relation("AccessorySubmissionDecisions")
  communityVehicleVariants         VehicleVariant[]            @relation("CommunityVehicleVariants")
  communityCaravanVariants         CaravanVariant[]            @relation("CommunityCaravanVariants")
  auditLogs                        AuditLog[]
  moderationActions                ModerationAction[]
  regulationSetVersions            RegulationSetVersion[]
  adminConfigUpdates               AdminConfig[]
  positionSubmissions              FitmentPositionSubmission[] @relation("PositionSubmissions")
  positionSubmissionDecisions      FitmentPositionSubmission[] @relation("PositionSubmissionDecisions")
  calibrationContributions         CalibrationContribution[]   @relation("CalibrationContributions")
  calibrationContributionDecisions CalibrationContribution[]   @relation("CalibrationContributionDecisions")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum MountingLocation {
  CHASSIS_FRONT
  CHASSIS_MID
  CHASSIS_REAR
  BULL_BAR
  ROOF_RACK
  ROOF_RAILS
  TRAY_FLOOR
  TRAY_SIDE_LEFT
  TRAY_SIDE_RIGHT
  TRAY_HEADBOARD
  TRAY_TAILGATE
  CANOPY_EXTERIOR
  CANOPY_INTERIOR
  CANOPY_ROOF
  TUB_INTERIOR
  TUB_EXTERIOR
  BONNET
  REAR_BAR
  TOW_HITCH
  WHEEL_ARCH_LEFT
  WHEEL_ARCH_RIGHT
  UNDERBODY_FRONT
  UNDERBODY_MID
  UNDERBODY_REAR
  A_PILLAR_LEFT
  A_PILLAR_RIGHT
  WINDSCREEN
  CABIN_INTERIOR
  CABIN_ROOF
  CABIN_DASH
  DOOR_LEFT
  DOOR_RIGHT
  SNORKEL
  FENDER_LEFT
  FENDER_RIGHT
  CARAVAN_DRAWBAR
  CARAVAN_A_FRAME
  CARAVAN_CHASSIS_FRONT
  CARAVAN_CHASSIS_MID
  CARAVAN_CHASSIS_REAR
  CARAVAN_UNDERBODY
  CARAVAN_ROOF
  CARAVAN_WALL_LEFT
  CARAVAN_WALL_RIGHT
  CARAVAN_WALL_FRONT
  CARAVAN_WALL_REAR
  CARAVAN_BUMPER_BAR
  CARAVAN_BOOT
  CARAVAN_TUNNEL_BOOT
  CARAVAN_TOOLBAR_EXTERNAL
  CARAVAN_TOOLBAR_INTERNAL
}

enum PositionType {
  FIXED
  ADJUSTABLE
  MODULAR
  SLIDING
}

enum FitmentConfidence {
  VERIFIED
  MANUFACTURER_SPEC
  COMMUNITY
  ESTIMATED
}

enum FitmentSource {
  OEM
  AFTERMARKET_VERIFIED
  USER_SUBMITTED
  CALCULATED
}

model AccessoryFitment {
  id                        String             @id @default(cuid())
  accessoryId               String
  vehicleVariantId          String?
  caravanVariantId          String?
  installedWeightKg         Decimal            @db.Decimal(8, 2)
  positionType              PositionType
  cogXMm                    Int?
  cogYMm                    Int?
  startXMm                  Int?
  endXMm                    Int?
  mountingLocation          MountingLocation
  providesMountingLocations MountingLocation[]
  mountOffsetXMm            Int?
  mountOffsetYMm            Int?
  mountOffsetZMm            Int?
  tankCapacityL             Decimal?           @db.Decimal(8, 2)
  tankContentsKgPerL        Decimal?           @db.Decimal(6, 3)
  confidence                FitmentConfidence  @default(ESTIMATED)
  source                    FitmentSource      @default(USER_SUBMITTED)
  notes                     String?
  verifiedById              String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  accessory                 Accessory          @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  vehicleVariant            VehicleVariant?    @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)
  caravanVariant            CaravanVariant?    @relation(fields: [caravanVariantId], references: [id], onDelete: Cascade)
  verifiedBy                User?              @relation("FitmentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  setupAccessories        SetupAccessory[]
  setupCaravanAccessories SetupCaravanAccessory[]
  accessorySubmissions    AccessorySubmission[]
  positionSubmissions     FitmentPositionSubmission[]

  @@index([vehicleVariantId, mountingLocation])
  @@index([caravanVariantId, mountingLocation])
  @@index([accessoryId])
}

// Community position pipeline: a user who has dragged an accessory into place
// on their rig (the top-down view) can contribute that placement. Submissions
// are PENDING until a moderator promotes the value onto the canonical
// AccessoryFitment.cogXMm/cogYMm, after which every future calculator that adds
// the accessory inherits the community-sourced default. This is the data moat.
model FitmentPositionSubmission {
  id               String           @id @default(cuid())
  submitterId      String?
  fitmentId        String
  vehicleVariantId String?
  caravanVariantId String?
  cogXMm           Int
  cogYMm           Int
  status           SubmissionStatus @default(PENDING)
  source           String?
  decidedById      String?
  decidedAt        DateTime?
  decisionNotes    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  submitter        User?            @relation("PositionSubmissions", fields: [submitterId], references: [id], onDelete: SetNull)
  decidedBy        User?            @relation("PositionSubmissionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  fitment          AccessoryFitment @relation(fields: [fitmentId], references: [id], onDelete: Cascade)
  vehicleVariant   VehicleVariant?  @relation(fields: [vehicleVariantId], references: [id], onDelete: SetNull)
  caravanVariant   CaravanVariant?  @relation(fields: [caravanVariantId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([fitmentId, status])
  @@index([vehicleVariantId])
  @@index([submitterId])
}

enum RegulationSetCode {
  AU_ADR
  NZ_VIRM
  US_FMVSS
  EU_UNECE
  GB_IVA
}

model Setup {
  id                      String                   @id @default(cuid())
  userId                  String
  name                    String
  vehicleVariantId        String?
  caravanVariantId        String?
  passengers              Int                      @default(2)
  cargoKg                 Decimal                  @default(0) @db.Decimal(8, 2)
  fuelPercent             Int                      @default(100)
  freshWaterPercent       Int                      @default(100)
  greyWaterPercent        Int                      @default(0)
  calibrationOverrides    Json                     @default("{}")
  vehicleSnapshot         Json?
  caravanSnapshot         Json?
  accessorySnapshot       Json?
  tags                    String[]
  shareToken              String                   @unique @default(cuid())
  regulationSetCode       RegulationSetCode        @default(AU_ADR)
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleVariant          VehicleVariant?          @relation(fields: [vehicleVariantId], references: [id], onDelete: SetNull)
  caravanVariant          CaravanVariant?          @relation(fields: [caravanVariantId], references: [id], onDelete: SetNull)
  accessories             SetupAccessory[]
  caravanAccessories      SetupCaravanAccessory[]
  customLoads             SetupCustomLoad[]
  weighbridgeMeasurements WeighbridgeMeasurement[]
  versions                SetupVersion[]

  @@index([userId])
  @@index([vehicleVariantId])
  @@index([caravanVariantId])
  @@index([shareToken])
  @@index([deletedAt])
}

model SetupAccessory {
  id               String           @id @default(cuid())
  setupId          String
  fitmentId        String
  parentId         String?
  quantityOverride Int              @default(1)
  fillPercent      Int              @default(100)
  cogXMmOverride   Int?
  cogYMmOverride   Int?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  setup            Setup            @relation(fields: [setupId], references: [id], onDelete: Cascade)
  fitment          AccessoryFitment @relation(fields: [fitmentId], references: [id], onDelete: Cascade)
  parent           SetupAccessory?  @relation("SetupAccessoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         SetupAccessory[] @relation("SetupAccessoryHierarchy")

  @@index([setupId])
  @@index([fitmentId])
  @@index([parentId])
}

model SetupCaravanAccessory {
  id               String                  @id @default(cuid())
  setupId          String
  fitmentId        String
  parentId         String?
  quantityOverride Int                     @default(1)
  fillPercent      Int                     @default(100)
  cogXMmOverride   Int?
  cogYMmOverride   Int?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  setup            Setup                   @relation(fields: [setupId], references: [id], onDelete: Cascade)
  fitment          AccessoryFitment        @relation(fields: [fitmentId], references: [id], onDelete: Cascade)
  parent           SetupCaravanAccessory?  @relation("SetupCaravanAccessoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         SetupCaravanAccessory[] @relation("SetupCaravanAccessoryHierarchy")

  @@index([setupId])
  @@index([fitmentId])
  @@index([parentId])
}

model SetupCustomLoad {
  id                String           @id @default(cuid())
  setupId           String
  label             String
  weightKg          Decimal          @db.Decimal(8, 2)
  mountingLocation  MountingLocation
  cogXMm            Int?
  cogYMm            Int?
  /**
   * Which side this load sits on (a user-made item may be placed anywhere).
   */
  placementScope    PlacementScope   @default(BOTH)
  side              PlacementScope? // resolved side it was actually placed on
  footprintLengthMm Int?
  footprintWidthMm  Int?
  /**
   * True when this load is the weighbridge-calibration "unaccounted mass" — the
   * residual M₀−P₀ realised as a positioned, draggable load (CALIBRATION_SIGNOFF.md
   * §4). Rendered/labelled distinctly; the user can drag it to where the mass sits.
   */
  isUnaccounted     Boolean          @default(false)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  setup             Setup            @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([setupId])
}

/**
 * What fidelity the weighbridge ticket reported (CALIBRATION_SIGNOFF.md §4).
 */
enum WeighbridgeGranularity {
  TOTAL
  AXLE
  CORNER
  TOWBALL
}

/**
 * A weighbridge calibration baseline for a setup: the measured ticket M₀ at a
 * given fidelity, plus the solved static mop-up offsets the engine applies. The
 * positioned "unaccounted load" lives as a SetupCustomLoad (isUnaccounted). The
 * "as weighed" config snapshot is captured for the delta math and (P2) versioning.
 * See CALIBRATION_SIGNOFF.md.
 */
model WeighbridgeMeasurement {
  id               String                 @id @default(cuid())
  setupId          String
  granularity      WeighbridgeGranularity
  /**
   * Measured values (kg). Only the fields for the granularity are populated.
   */
  totalKg          Decimal?               @db.Decimal(8, 2)
  frontAxleKg      Decimal?               @db.Decimal(8, 2)
  rearAxleKg       Decimal?               @db.Decimal(8, 2)
  cornerFlKg       Decimal?               @db.Decimal(8, 2)
  cornerFrKg       Decimal?               @db.Decimal(8, 2)
  cornerRlKg       Decimal?               @db.Decimal(8, 2)
  cornerRrKg       Decimal?               @db.Decimal(8, 2)
  towBallKg        Decimal?               @db.Decimal(8, 2)
  /**
   * User chose "I don't know where the mass is" → fully static, no positioned load.
   */
  preferStaticOnly Boolean                @default(false)
  /**
   * Solved CalibrationStaticOffsets (the engine's vehicleStaticOffsets), JSON.
   */
  staticOffsets    Json                   @default("{}")
  /**
   * Config snapshot the rig was weighed at (C₀) — the delta-math anchor.
   */
  weighedSnapshot  Json?
  /**
   * Free-text trace of what the solve reproduced (entry-panel display).
   */
  notes            String?
  measuredAt       DateTime               @default(now())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  setup            Setup                  @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([setupId])
}

/**
 * P3 — the data moat. An opt-in, anonymisable contribution of a weighbridge
 * calibration for a specific vehicle variant, feeding a per-model regression
 * that improves the base kerb-mass and kerb-CoG estimates for everyone.
 * PRINCIPLE: store raw, derive later. We persist the measurement (M₀), the
 * weighed config snapshot (C₀) and the model prediction (P₀) verbatim, so the
 * derivation formula is never frozen into the data and can be re-run as the
 * math matures (see CALIBRATION_SIGNOFF.md §5). The derived `*Delta` columns are
 * a recomputable cache for fast moderation aggregation, NOT the source of truth.
 * Mirrors the Phase C FitmentPositionSubmission pipeline. submitterId is nullable
 * for anonymous contributions; moderation never exposes contributor identity.
 */
model CalibrationContribution {
  id               String                 @id @default(cuid())
  submitterId      String?
  vehicleVariantId String
  granularity      WeighbridgeGranularity
  /**
   * M₀ — the measured ticket (granularity + values), JSON.
   */
  measurement      Json
  /**
   * C₀ — full calculator state the rig was weighed at, JSON.
   */
  weighedSnapshot  Json
  /**
   * P₀ — the model's prediction for C₀ (axles/total/corners), JSON.
   */
  prediction       Json
  // ── Derived cache (recomputable from the raw JSON above) ──
  measuredTotalKg  Float
  predictedTotalKg Float
  /**
   * ΔM = measured − predicted total: the unexplained mass.
   */
  residualMassKg   Float
  /**
   * kerb / measuredTotal ∈ (0,1]; ~1 = stripped vehicle = pristine base read.
   */
  barenessWeight   Float
  /**
   * Per-contribution kerb-mass signal (kg).
   */
  kerbMassDeltaKg  Float?
  /**
   * Per-contribution kerb-CoG-fraction signal; null when no axle/corner data.
   */
  cogFractionDelta Float?
  status           SubmissionStatus       @default(PENDING)
  source           String?
  decidedById      String?
  decidedAt        DateTime?
  decisionNotes    String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  submitter        User?                  @relation("CalibrationContributions", fields: [submitterId], references: [id], onDelete: SetNull)
  decidedBy        User?                  @relation("CalibrationContributionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  vehicleVariant   VehicleVariant         @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([vehicleVariantId, status])
  @@index([submitterId])
}

/**
 * The approved per-variant correction the engine reads via CalibrationOverrides.
 * Two independent corrections from the same contribution pool:
 * - kerb-MASS (unconfounded enough to auto-apply once it clears the min-N gate),
 * - kerb-CoG-FRACTION (a delta on VEHICLE_KERB_COG_FRACTION; GATED — never applied
 * until `cogApplied` is set by a Rule-11 sign-off, because the "everyone loads
 * the back" confound needs human review). See CALIBRATION_SIGNOFF.md §5.
 */
model VehicleCalibrationCorrection {
  id                  String         @id @default(cuid())
  vehicleVariantId    String         @unique
  /**
   * Robust (median) kerb-mass delta in kg; null until min-N met.
   */
  kerbMassDeltaKg     Float?
  kerbMassSampleCount Int            @default(0)
  kerbMassApplied     Boolean        @default(false)
  /**
   * Robust (median) delta on the kerb-CoG wheelbase fraction; null until min-N met.
   */
  cogFractionDelta    Float?
  cogSampleCount      Int            @default(0)
  /**
   * Gated: requires explicit physics sign-off before the engine uses it.
   */
  cogApplied          Boolean        @default(false)
  updatedAt           DateTime       @updatedAt
  vehicleVariant      VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)
}

/**
 * A named, dated snapshot of a setup's full calculator state (+ a compact result
 * summary), for versioning: save "as weighed" / "loaded for the trip" baselines,
 * revert to any of them, and compare two side-by-side. `stateSnapshot` is the
 * serialized CalculatorState (which carries weighbridge calibration), so a revert
 * restores everything via the LOAD_STATE loader. See RIG_LAYOUT.md "Phase E / P2".
 */
model SetupVersion {
  id                String   @id @default(cuid())
  setupId           String
  label             String
  note              String?
  /**
   * Serialized CalculatorState — the full editable state at snapshot time.
   */
  stateSnapshot     Json
  /**
   * Compact computed metrics (GVM/axles/tow-ball/status) for list + compare.
   */
  resultSummary     Json?
  /**
   * True when this snapshot is the weighbridge calibration baseline ("as weighed").
   */
  isWeighedBaseline Boolean  @default(false)
  createdAt         DateTime @default(now())
  setup             Setup    @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([setupId])
}

enum SubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DEFERRED
}

model VehicleSubmission {
  id                      String           @id @default(cuid())
  submitterId             String
  status                  SubmissionStatus @default(DRAFT)
  submittedData           Json
  compliancePlatePhotoUrl String?
  additionalPhotoUrls     String[]
  // Tier 1: synchronous Tesseract pre-fill output (raw OCR text + per-field extracted values)
  ocrData                 Json?
  // Tier 2: async Qwen3.6 VLM extraction result (structured JSON with confidence scores)
  vlmExtractionResult     Json?
  // Tier 2: VLM gatekeeper assessment (plate authenticity, anomaly flags, recommended action)
  vlmGatekeeperResult     Json?
  // BullMQ job ID for the async VLM processing job
  vlmJobId                String?
  // Duplicate detection fingerprint (make+model+year+body+drivetrain+transmission hash)
  duplicateFingerprint    String?
  // Set when submission is flagged as a potential duplicate of an existing entry
  suspectedDuplicateOfId  String?
  // Set when the user explicitly asserts their entry is different from a flagged duplicate
  dupSuspected            Boolean          @default(false)
  notes                   String?
  decidedById             String?
  decidedAt               DateTime?
  decisionNotes           String?
  resultingVariantId      String?
  // Draft auto-expires after 30 days of inactivity
  draftExpiresAt          DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  submitter               User             @relation("VehicleSubmissions", fields: [submitterId], references: [id], onDelete: Cascade)
  decidedBy               User?            @relation("VehicleSubmissionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  resultingVariant        VehicleVariant?  @relation(fields: [resultingVariantId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submitterId])
  @@index([duplicateFingerprint])
}

model CaravanSubmission {
  id                      String           @id @default(cuid())
  submitterId             String
  status                  SubmissionStatus @default(DRAFT)
  submittedData           Json
  compliancePlatePhotoUrl String?
  additionalPhotoUrls     String[]
  ocrData                 Json?
  vlmExtractionResult     Json?
  vlmGatekeeperResult     Json?
  vlmJobId                String?
  duplicateFingerprint    String?
  suspectedDuplicateOfId  String?
  dupSuspected            Boolean          @default(false)
  notes                   String?
  decidedById             String?
  decidedAt               DateTime?
  decisionNotes           String?
  resultingVariantId      String?
  draftExpiresAt          DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  submitter               User             @relation("CaravanSubmissions", fields: [submitterId], references: [id], onDelete: Cascade)
  decidedBy               User?            @relation("CaravanSubmissionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  resultingVariant        CaravanVariant?  @relation(fields: [resultingVariantId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submitterId])
  @@index([duplicateFingerprint])
}

model AccessorySubmission {
  id                        String             @id @default(cuid())
  submitterId               String
  status                    SubmissionStatus   @default(DRAFT)
  brandId                   String?
  categoryId                String?
  submittedData             Json
  productPhotoUrl           String?
  installationPhotoUrl      String?
  // For accessories: VLM does visual similarity check against existing photos
  vlmSimilarityResult       Json?
  vlmJobId                  String?
  duplicateFingerprint      String?
  suspectedDuplicateOfId    String?
  dupSuspected              Boolean            @default(false)
  appliesToVehicleVariantId String?
  appliesToCaravanVariantId String?
  // When false, submission is private to the submitter (sharing toggle off)
  isShared                  Boolean            @default(true)
  notes                     String?
  decidedById               String?
  decidedAt                 DateTime?
  decisionNotes             String?
  resultingAccessoryId      String?
  resultingFitmentId        String?
  draftExpiresAt            DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  submitter                 User               @relation("AccessorySubmissions", fields: [submitterId], references: [id], onDelete: Cascade)
  decidedBy                 User?              @relation("AccessorySubmissionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  brand                     AccessoryBrand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category                  AccessoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  appliesToVehicleVariant   VehicleVariant?    @relation(fields: [appliesToVehicleVariantId], references: [id], onDelete: SetNull)
  appliesToCaravanVariant   CaravanVariant?    @relation(fields: [appliesToCaravanVariantId], references: [id], onDelete: SetNull)
  resultingAccessory        Accessory?         @relation(fields: [resultingAccessoryId], references: [id], onDelete: SetNull)
  resultingFitment          AccessoryFitment?  @relation(fields: [resultingFitmentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submitterId])
  @@index([brandId])
  @@index([categoryId])
  @@index([duplicateFingerprint])
}

enum SponsorStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

enum PlacementType {
  ACCESSORY_FEATURED
  CATEGORY_TOP
  RECOMMENDATION_PINNED
  VEHICLE_TYPE_FEATURED
}

enum PlacementTier {
  FEATURED_FIT
  CATEGORY_TOP
  RECOMMENDATION_PINNED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum ModerationActionType {
  APPROVE
  REJECT
  REQUEST_INFO
}

model Sponsor {
  id               String               @id @default(cuid())
  name             String               @unique
  contactName      String?
  contactEmail     String?
  billingReference String?
  status           SponsorStatus        @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  placements       SponsoredPlacement[]

  @@index([status])
}

model SponsoredPlacement {
  id              String             @id @default(cuid())
  sponsorId       String
  placementType   PlacementType
  accessoryId     String?
  categoryId      String?
  vehicleBodyType VehicleBodyType?
  stateFilter     AustralianState?
  startsAt        DateTime
  endsAt          DateTime
  tier            PlacementTier
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sponsor         Sponsor            @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  accessory       Accessory?         @relation(fields: [accessoryId], references: [id], onDelete: SetNull)
  category        AccessoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([sponsorId])
  @@index([placementType])
  @@index([startsAt, endsAt])
  @@index([accessoryId])
  @@index([categoryId])
}

model RegulationSet {
  id            String                 @id @default(cuid())
  code          String                 @unique
  name          String
  parentSetCode String?
  rules         Json                   @default("{}")
  market        Market                 @default(AU)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  parent        RegulationSet?         @relation("RegulationSetHierarchy", fields: [parentSetCode], references: [code], onDelete: SetNull)
  children      RegulationSet[]        @relation("RegulationSetHierarchy")
  versions      RegulationSetVersion[]

  @@index([parentSetCode])
  @@index([market])
}

model RegulationSetVersion {
  id            String        @id @default(cuid())
  setId         String
  effectiveDate DateTime
  changeSummary String
  data          Json
  createdById   String
  createdAt     DateTime      @default(now())
  set           RegulationSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([setId, effectiveDate])
  @@index([createdById])
}

model AuditLog {
  id         String      @id @default(cuid())
  entityType String
  entityId   String
  action     AuditAction
  changedBy  String
  changes    Json        @default("{}")
  reason     String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([changedBy])
  @@index([action])
  @@index([createdAt])
}

model AdminConfig {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
}

model VariantSlugRedirect {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  modelId    String
  fromSlug   String
  toSlug     String
  createdAt  DateTime @default(now())

  @@index([entityType, modelId, fromSlug])
  @@index([entityId])
}

model ModerationAction {
  id             String               @id @default(cuid())
  submissionType String
  submissionId   String
  moderatorId    String
  action         ModerationActionType
  notes          String?
  createdAt      DateTime             @default(now())
  moderator      User                 @relation(fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([submissionType, submissionId])
  @@index([moderatorId])
  @@index([action])
  @@index([createdAt])
}

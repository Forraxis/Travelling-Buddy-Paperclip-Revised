generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VehicleVariantStatus {
  CATALOGUE
  COMMUNITY
}

/**
 * Per-field confidence the *provider* attaches to a fetched spec value.
 * ⚠️ NEVER a gating signal: an ungrounded local model confidently self-rates
 * hallucinated compliance numbers "HIGH" (verified on the LandCruiser 100 —
 * GVM/GCM/kerb/tank all wrong, all "high"). Gating trust comes only from
 * external corroboration (source URL / plate photo / admin tick).
 */
enum SpecFieldConfidence {
  HIGH
  MEDIUM
  LOW
}

/**
 * Where a fetched vehicle-spec candidate (or one of its fields) came from.
 */
enum SpecFetchProvider {
  MOCK
  QWEN
  CLAUDE
  ADMIN
  // ROVER = a figure parsed deterministically from a federal RVSA approval
  // consumer report (no LLM transcribed the number) → auto-corroborated.
  ROVER
}

/**
 * Which ROVER per-VTA document a RoverDocument archive row holds.
 */
enum RoverDocType {
  RVD
  APPROVAL_NOTICE
}

/**
 * Skeleton expansion state in RoverApprovalIndex.
 */
enum RoverIndexExpandState {
  UNFETCHED // names only (from the grid) — no spec data yet
  EXPANDED // RVD detail fetched → variants created
  SKIPPED // intentionally not expanded
}

/**
 * What KIND of second-stage manufacture a RoverApprovalIndex row represents, once
 * classified (P2). NONE = not a second-stage approval (a base/OEM variant).
 * GVM_UPGRADE = a suspension/GVM upgrade kit (Ironman, Lovells, Premcar…) that
 * raises mass limits over the factory base — these promote to a GvmUpgrade overlay
 * on the base variant, not a standalone variant.
 */
enum RoverSecondStageType {
  NONE
  GVM_UPGRADE
  CONVERSION
  MOTORHOME
  OTHER
}

/**
 * The regulatory pathway a GVM upgrade was certified under. A pre-rego second-stage
 * manufacture (SSM) is recognised nationally; a post-rego SSM or state-engineer
 * certification has state-specific recognition (see gvm-caps / interstate warning).
 */
enum GvmUpgradePathway {
  PRE_REGO_SECOND_STAGE
  POST_REGO_SSM
  STATE_ENGINEER
}

/**
 * Make/model normalization state in RoverApprovalIndex.
 */
enum RoverNormalizationStatus {
  UNPROCESSED // not yet normalized
  AUTO // resolved automatically (OEM match / learned model→make map)
  NEEDS_REVIEW // ambiguous — base make couldn't be resolved confidently (AI/human next)
  MANUAL // set by an admin
}

/**
 * Where an accepted per-field spec value came from (VariantSpecProvenance).
 */
enum SpecProvenanceSource {
  ROVER // structured federal approval doc — authoritative for the fields it carries
  CLAUDE // grounded-AI estimate (gated for criticals)
  PLATE // compliance plate (VLM-confirmed) — per-rig truth
  COMMUNITY // user-submitted, aggregated via the P3 moat
  MANUAL // admin-entered
  QLD_REGO // QLD TMR registration fleet aggregate (GVM/kerb mode) — ESTIMATE pre-fill
}

/**
 * Trust state of an accepted per-field value.
 */
enum SpecProvenanceStatus {
  CONFIRMED // authoritative (ROVER/plate) or ≥K cross-source agreement
  ESTIMATE // single-source AI / unconfirmed — gated for compliance-criticals
  DISPUTED // independent sources disagree
}

enum VehicleBodyType {
  DUAL_CAB_UTE
  SINGLE_CAB_UTE
  EXTRA_CAB_UTE
  WAGON
  SUV
  VAN
  TROOPCARRIER
  OTHER
}

enum FuelType {
  DIESEL
  PETROL
  HYBRID
  ELECTRIC
}

enum Market {
  AU
  NZ
  US
  EU
  GB
}

enum CaravanBodyType {
  CARAVAN_POP_TOP
  CARAVAN_FULL_HEIGHT
  OFF_ROAD_CARAVAN
  CAMPER_TRAILER
  HYBRID
  FIFTH_WHEELER
  OTHER
}

enum AxleConfiguration {
  SINGLE_AXLE
  DUAL_AXLE_CLOSE_COUPLED
  DUAL_AXLE_SPREAD
  TRIPLE_AXLE
}

enum CaravanVariantStatus {
  CATALOGUE
  COMMUNITY
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum PlacementScope {
  VEHICLE
  CARAVAN
  BOTH
}

enum AccessoryStatus {
  ACTIVE
  DISCONTINUED
  PLACEHOLDER
  COMMUNITY
}

model VehicleMake {
  id              String         @id @default(cuid())
  name            String         @unique
  slug            String         @unique
  logoUrl         String?
  countryOfOrigin String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  models          VehicleModel[]

  @@index([slug])
}

model VehicleModel {
  id        String           @id @default(cuid())
  makeId    String
  name      String
  slug      String
  bodyType  VehicleBodyType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  make      VehicleMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants  VehicleVariant[]

  @@unique([makeId, slug])
  @@index([slug])
  @@index([makeId])
}

model VehicleVariant {
  id                       String                        @id @default(cuid())
  modelId                  String
  yearFrom                 Int
  yearTo                   Int
  isCurrentProduction      Boolean                       @default(false)
  name                     String
  slug                     String
  // Community-submitted variants have status=COMMUNITY until moderation approves them.
  // Catalogue entries are CATALOGUE (default).
  status                   VehicleVariantStatus          @default(CATALOGUE)
  communitySubmitterId     String?
  gvmKg                    Int?
  gcmKg                    Int?
  kerbWeightKg             Int?
  maxTowingCapacityKg      Int?
  frontAxleLimitKg         Int?
  rearAxleLimitKg          Int?
  wheelbaseMm              Int?
  frontOverhangMm          Int?
  rearOverhangMm           Int?
  totalLengthMm            Int?
  maxTowBallDownloadKg     Int?
  maxRoofLoadKg            Int? // manufacturer dynamic roof-load limit — rooftop tents/racks eat GVM + raise CoG (source: manual/AI/plate, not QLD)
  fuelTankCapacityL        Int?
  fuelType                 FuelType?
  market                   Market                        @default(AU)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  model                    VehicleModel                  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  communitySubmitter       User?                         @relation("CommunityVehicleVariants", fields: [communitySubmitterId], references: [id], onDelete: SetNull)
  fitments                 AccessoryFitment[]
  setups                   Setup[]
  vehicleSubmissions       VehicleSubmission[]
  accessorySubmissions     AccessorySubmission[]
  positionSubmissions      FitmentPositionSubmission[]
  calibrationContributions CalibrationContribution[]
  calibrationCorrection    VehicleCalibrationCorrection?
  specCandidates           VehicleSpecCandidate[]        @relation("SpecCandidateVariant")
  specProvenance           VariantSpecProvenance[]
  gvmUpgrades              GvmUpgrade[]

  @@unique([modelId, slug])
  @@index([slug])
  @@index([modelId])
  @@index([status, communitySubmitterId])
}

// Per-field provenance — the "spine" of the Vehicle Data Hub (VEHICLE_DATA_HUB.md).
// One row per (variant, field): the accepted value, who said so, how confident, and
// when. Field-agnostic — `value` is a canonical string keyed by `field`, so the broad
// Tier-B sweep (powertrain/efficiency) is stored here WITHOUT adding typed columns to
// VehicleVariant; the calculator keeps reading the typed columns it already has, while
// the hub + fuel app read provenance. Lets the verdict engine narrow "Est. — confirm
// your plate" to the specific estimated fields instead of the whole variant.
model VariantSpecProvenance {
  id                 String               @id @default(cuid())
  variantId          String
  // Canonical field key — matches the spec-field catalogue / VehicleVariant column
  // name where one exists; any key is allowed (Tier-B fields have no column).
  field              String
  // Canonical string value; null = "known absent" (never a guessed 0).
  value              String?
  source             SpecProvenanceSource
  // Gated by default: an AI single-source value is an ESTIMATE until a plate or
  // cross-source agreement confirms it. ROVER-carried fields promote as CONFIRMED.
  status             SpecProvenanceStatus @default(ESTIMATE)
  confidence         SpecFieldConfidence?
  // Citation (grounded-Claude per-field source URL, ROVER report URL, …).
  sourceUrl          String?
  // Independent authoritative sources agreeing (drives the cross-source upgrade).
  corroboratingCount Int                  @default(0)
  // When the value was sourced / last reviewed — the "current as of [date]" stamp + staleness.
  asOf               DateTime             @default(now())
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  variant            VehicleVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, field])
  @@index([variantId])
  @@index([field])
  @@index([status])
}

/**
 * A GVM (and optionally GCM / axle / towing) upgrade applied OVER a base
 * VehicleVariant — a suspension/second-stage kit (Ironman, Lovells, Premcar, MRT…)
 * or a state-engineer certification that lifts the factory mass limits. Modelled as
 * an overlay on the base variant rather than a standalone variant: the calculator
 * keeps the base figures and applies this delta when the user picks their kit
 * (Setup.appliedGvmUpgradeId). Promoted from a second-stage ROVER candidate (P4).
 * Rule 11: the physics overlay that uses these limits stays behind
 * GVM_UPGRADE_ENABLED + advisory until signed off.
 */
model GvmUpgrade {
  id               String               @id @default(cuid())
  baseVariantId    String
  modifierName     String
  pathway          GvmUpgradePathway
  vtaNumber        String?
  engineerRef      String?
  // Upgraded limits (kg). Only the figures the upgrade actually states are set;
  // a null field means "the upgrade doesn't move this limit" → keep the factory value.
  gvmKg            Int?
  gcmKg            Int?
  frontAxleLimitKg Int?
  rearAxleLimitKg  Int?
  maxTowingKg      Int?
  // Mass the kit itself adds to the vehicle (heavier springs, etc.).
  addedMassKg      Int?
  isPreRego        Boolean              @default(false)
  // For post-rego / state-engineer paths, the state the cert is recognised in.
  certifiedState   AustralianState?
  status           VehicleVariantStatus @default(CATALOGUE)
  sourceUrl        String?
  sourceVtaNumber  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  baseVariant      VehicleVariant       @relation(fields: [baseVariantId], references: [id], onDelete: Cascade)
  appliedSetups    Setup[]

  @@index([baseVariantId])
}

model CaravanMake {
  id              String         @id @default(cuid())
  name            String         @unique
  slug            String         @unique
  logoUrl         String?
  countryOfOrigin String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  models          CaravanModel[]

  @@index([slug])
}

model CaravanModel {
  id        String           @id @default(cuid())
  makeId    String
  name      String
  slug      String
  bodyType  CaravanBodyType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  make      CaravanMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants  CaravanVariant[]

  @@unique([makeId, slug])
  @@index([slug])
  @@index([makeId])
}

model CaravanVariant {
  id                   String                      @id @default(cuid())
  modelId              String
  status               CaravanVariantStatus        @default(CATALOGUE)
  communitySubmitterId String?
  yearFrom             Int
  yearTo               Int
  isCurrentProduction  Boolean                     @default(false)
  name                 String
  slug                 String
  atmKg                Int?
  gtmKg                Int?
  tareKg               Int?
  tbmKg                Int?
  axleConfiguration    AxleConfiguration
  couplingToAxleMm     Int?
  axleSpacingMm        Int?
  bodyLengthMm         Int?
  overallLengthMm      Int?
  freshWaterCapacityL  Int?
  greyWaterCapacityL   Int?
  gasBottleConfig      String?
  market               Market                      @default(AU)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  model                CaravanModel                @relation(fields: [modelId], references: [id], onDelete: Cascade)
  communitySubmitter   User?                       @relation("CommunityCaravanVariants", fields: [communitySubmitterId], references: [id], onDelete: SetNull)
  fitments             AccessoryFitment[]
  setups               Setup[]
  caravanSubmissions   CaravanSubmission[]
  accessorySubmissions AccessorySubmission[]
  positionSubmissions  FitmentPositionSubmission[]
  specProvenance       CaravanVariantSpecProvenance[]

  @@unique([modelId, slug])
  @@index([slug])
  @@index([modelId])
  @@index([status, communitySubmitterId])
}

/// Per-field provenance for a CaravanVariant spec value — the caravan mirror of
/// VariantSpecProvenance. ATM/GTM/tare/ball etc. carry source + status + confidence so the
/// catalogue can grade + cite each value (CONFIRMED via >=K agreeing listings, ESTIMATE
/// single-source, plate=VERIFIED later) and drive the same "help us verify" UX as vehicles.
model CaravanVariantSpecProvenance {
  id                 String               @id @default(cuid())
  variantId          String
  field              String
  value              String?
  source             SpecProvenanceSource
  status             SpecProvenanceStatus @default(ESTIMATE)
  confidence         SpecFieldConfidence?
  sourceUrl          String?
  corroboratingCount Int                  @default(0)
  asOf               DateTime             @default(now())
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  variant            CaravanVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, field])
  @@index([variantId])
  @@index([field])
  @@index([status])
}

model AccessoryBrand {
  id                   String                @id @default(cuid())
  name                 String                @unique
  slug                 String                @unique
  logoUrl              String?
  websiteUrl           String?
  status               BrandStatus           @default(ACTIVE)
  isPartner            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accessories          Accessory[]
  accessorySubmissions AccessorySubmission[]

  @@index([slug])
}

model AccessoryCategory {
  id                   String                @id @default(cuid())
  name                 String                @unique
  slug                 String                @unique
  description          String?
  parentId             String?
  displayOrder         Int                   @default(0)
  iconName             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  parent               AccessoryCategory?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children             AccessoryCategory[]   @relation("CategoryHierarchy")
  accessories          Accessory[]
  accessorySubmissions AccessorySubmission[]
  sponsoredPlacements  SponsoredPlacement[]

  @@index([slug])
  @@index([parentId])
}

model Accessory {
  id                   String                @id @default(cuid())
  brandId              String
  categoryId           String
  name                 String
  slug                 String
  description          String?
  imageUrls            String[]
  priceMin             Decimal?              @db.Decimal(10, 2)
  priceMax             Decimal?              @db.Decimal(10, 2)
  currencyCode         String                @default("AUD")
  affiliateUrl         String?
  status               AccessoryStatus       @default(ACTIVE)
  market               Market                @default(AU)
  /**
   * Where this item may be mounted in the layout editor.
   */
  placementScope       PlacementScope        @default(BOTH)
  /**
   * Optional real top-down image (R2) — overrides the category icon.
   */
  topDownImageUrl      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  brand                AccessoryBrand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category             AccessoryCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fitments             AccessoryFitment[]
  accessorySubmissions AccessorySubmission[]
  sponsoredPlacements  SponsoredPlacement[]

  @@unique([brandId, slug])
  @@index([slug])
  @@index([brandId])
  @@index([categoryId])
}

enum UserRole {
  ADMIN
  MODERATOR
  CONTRIBUTOR
  VIEWER
}

enum AustralianState {
  NSW
  VIC
  QLD
  WA
  SA
  TAS
  NT
  ACT
}

enum TrustTier {
  NEW
  BASIC
  TRUSTED
  EXPERT
}

model User {
  id                               String                      @id @default(cuid())
  name                             String?
  email                            String                      @unique
  emailVerified                    DateTime?
  image                            String?
  password                         String?
  role                             UserRole                    @default(VIEWER)
  homeState                        AustralianState?
  trustTier                        TrustTier                   @default(NEW)
  notificationPreferences          Json                        @default("{}")
  deletedAt                        DateTime?
  scheduledHardDeleteAt            DateTime?
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime                    @updatedAt
  accounts                         Account[]
  sessions                         Session[]
  setups                           Setup[]
  verifiedFitments                 AccessoryFitment[]          @relation("FitmentVerifier")
  vehicleSubmissions               VehicleSubmission[]         @relation("VehicleSubmissions")
  vehicleSubmissionDecisions       VehicleSubmission[]         @relation("VehicleSubmissionDecisions")
  caravanSubmissions               CaravanSubmission[]         @relation("CaravanSubmissions")
  caravanSubmissionDecisions       CaravanSubmission[]         @relation("CaravanSubmissionDecisions")
  accessorySubmissions             AccessorySubmission[]       @relation("AccessorySubmissions")
  accessorySubmissionDecisions     AccessorySubmission[]       @relation("AccessorySubmissionDecisions")
  communityVehicleVariants         VehicleVariant[]            @relation("CommunityVehicleVariants")
  communityCaravanVariants         CaravanVariant[]            @relation("CommunityCaravanVariants")
  auditLogs                        AuditLog[]
  moderationActions                ModerationAction[]
  regulationSetVersions            RegulationSetVersion[]
  adminConfigUpdates               AdminConfig[]
  positionSubmissions              FitmentPositionSubmission[] @relation("PositionSubmissions")
  positionSubmissionDecisions      FitmentPositionSubmission[] @relation("PositionSubmissionDecisions")
  calibrationContributions         CalibrationContribution[]   @relation("CalibrationContributions")
  calibrationContributionDecisions CalibrationContribution[]   @relation("CalibrationContributionDecisions")
  specCandidatesCreated            VehicleSpecCandidate[]      @relation("SpecCandidatesCreated")
  specCandidateDecisions           VehicleSpecCandidate[]      @relation("SpecCandidateDecisions")
  specCandidateOverrides           VehicleSpecCandidate[]      @relation("SpecCandidateOverrides")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}


# TravellingBuddy Environment Variables
# Copy this file to .env.local and fill in the values

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3070
NEXT_PUBLIC_SITE_NAME=TravellingBuddy

# Database (Phase 1)
DATABASE_URL=postgresql://user:password@localhost:5432/travellingbuddy

# Authentication (Phase 9)
# NEXTAUTH_URL=http://localhost:3070
# NEXTAUTH_SECRET=

# Analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=travellingbuddy.com.au

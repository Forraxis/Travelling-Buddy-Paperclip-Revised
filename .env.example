# TravellingBuddy Environment Variables
# Copy this file to .env.local and fill in the values

# Application
NEXT_PUBLIC_SITE_URL=https://tb.dev.ragebots.me
NEXT_PUBLIC_SITE_NAME=TravellingBuddy

# Database (Phase 1)
DATABASE_URL=postgresql://travelbuddy:travelbuddy_dev@localhost:5432/travellingbuddy

# Authentication (Phase 9)
AUTH_SECRET=<generate with: openssl rand -base64 32>
AUTH_URL=https://tb.dev.ragebots.me
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
# In production the server refuses to boot without AUTH_SECRET, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET and NEXT_PUBLIC_SITE_URL (validated in src/lib/env.ts).

# Admin seeding (Phase 11.1) — email/password for the seeded ADMIN role user
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 Object Storage (Phase 10)
# Provision a bucket in the Cloudflare dashboard and create an R2 API token.
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=travellingbuddy-photos
# Public URL for serving uploaded photos (set after enabling R2 public access or custom domain)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Redis / BullMQ — async job queue for VLM processing (Phase 10)
REDIS_URL=redis://localhost:6379
# BullMQ workers start in-process via src/instrumentation.ts on server boot.
# Set to "true" to disable that and run workers as a standalone process instead.
WORKERS_DISABLED=

# VLM inference — Qwen3.6-35B-A3B via Cloudflare Tunnel (Phase 10)
# OpenAI-compatible endpoint served from on-prem Proxmox via tunnel
# Tim provides the Cloudflare Tunnel URL — set VLM_ENDPOINT_URL to the /v1 base path
VLM_ENDPOINT_URL=https://vlm.internal.travellingbuddy.com.au/v1
VLM_API_KEY=
VLM_MODEL=Qwen/Qwen3-35B-A3B

# Vehicle spec fetch — AI/admin-assisted catalogue ingestion (all optional).
# The admin pipeline runs on a MOCK provider by default; these only matter for
# LIVE fetches, which are additionally gated by SPEC_FETCH_LIVE_ENABLED.
# QWEN = Tim's local llama.cpp OpenAI-compatible server (no key); it is UNGROUNDED
# and hallucinates compliance numbers, so its output is always admin-gated.
QWEN_BASE_URL=http://172.16.45.150:8082
QWEN_MODEL=qwen36-35b-a3b-q4
# ANTHROPIC_API_KEY backs the future grounded Claude path (the real data source).
ANTHROPIC_API_KEY=
# Hard gate: the live spec-fetch worker refuses to call a model / persist output
# unless this is exactly "true". Leave unset to keep the pipeline mock-only.
SPEC_FETCH_LIVE_ENABLED=
# Bearer token for the ROVER ingest webhook (POST /api/rover/ingest), which n8n
# calls with a VTADetails page's HTML. Unset = the endpoint returns 404 and stays
# invisible. Set to a long random secret (and the same value in n8n) to enable it.
ROVER_INGEST_TOKEN=

# Email — Resend transactional email (Phase 10.9)
# Create an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TravellingBuddy <noreply@travellingbuddy.com.au>

# Analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=travellingbuddy.com.au

# Monetisation — Google AdSense (display ads on SEO/content pages only).
# Ad slots are completely inert until this is set; add it once AdSense approves
# the live domain. Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=

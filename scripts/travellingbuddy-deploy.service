[Unit]
Description=TravellingBuddy pull-based deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/travellingbuddy
ExecStart=/opt/travellingbuddy/scripts/deploy-pull.sh
Environment=DEPLOY_BRANCH=develop
StandardOutput=append:/var/log/travellingbuddy/deploy.log
StandardError=append:/var/log/travellingbuddy/deploy.log
